/* Veridia — forest teal, cream highlights, soft rose. */
$bg-color: #0f1a18;
$main-color: #f2efe4;
$caret-color: #d4e8a0;
$sub-color: #7aa89a;
$sub-alt-color: #1a2e28;
$text-color: #f2efe4;
$error-color: #e85d7a;
$error-extra-color: #f0a070;
$colorful-error-color: #e85d7a;
$colorful-error-extra-color: #f0a070;
$chips-color: #2ec4a8;
$mult-color: #d45a8a;
$gold-color: #e8d88a;
$card-bg: #f2efe4;
$card-text: #102820;

DitherBackground {
  .--dither-shadow {
    color: #142820 55%;
  }

  .--dither-teal {
    color: $chips-color 48%;
  }

  .--dither-magenta {
    color: $mult-color 42%;
  }

  .--dither-gold {
    color: $gold-color 52%;
  }

  .--dither-sparkle {
    color: #b8e86a 60%;
  }
}
