/* Bathyn — deep violet, teal waves, magenta hills. */
$bg-color: #12101a;
$main-color: #f5f0e8;
$caret-color: #ffe08a;
$sub-color: #9b8ec4;
$sub-alt-color: #2a1f42;
$text-color: #f5f0e8;
$error-color: #ff5c7a;
$error-extra-color: #ff9a6e;
$colorful-error-color: #ff5c7a;
$colorful-error-extra-color: #ff9a6e;
$chips-color: #1db9b0;
$mult-color: #e848a0;
$gold-color: #ffe08a;
$card-bg: #f5f0e8;
$card-text: #1a1028;

DitherBackground {
  .--dither-dim {
    color: #2a1848 55%;
  }

  .--dither-mid {
    color: $chips-color 40%;
  }

  .--dither-bright {
    color: $gold-color 50%;
  }
}
